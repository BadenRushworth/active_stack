# frozen_string_literal: true
# Generated by `rails g active_engine:migratable`. Safe to edit.

require "active_support/concern"

module <%= mod %>
  module Concerns
    # Appends this engine's db/migrate path to the host app's migration paths,
    # so `rails db:migrate` runs engine migrations directly. No copies to drift
    # out of sync, and no `<engine>:install:migrations` step.
    module Migratable
      extend ActiveSupport::Concern

      included do
        initializer "#{engine_name}.append_migrations" do |app|
          next if File.expand_path(app.root.to_s) == File.expand_path(root.to_s)

          host_paths = app.config.paths["db/migrate"]
          config.paths["db/migrate"].expanded.each do |path|
            host_paths << path unless host_paths.expanded.include?(path)
          end
        end
      end
    end
  end
end
