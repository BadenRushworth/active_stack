# frozen_string_literal: true
# Generated by `rails g active_engine:assetable`. Safe to edit.

module <%= mod %>
  module AssetsHelper
    # Importmap + entry point for this engine's layout:
    #   <%%= <%= helper_prefix %>_importmap_tags %>
    def <%= helper_prefix %>_importmap_tags(entry_point = "<%= ns %>/application")
      javascript_importmap_tags(entry_point, importmap: <%= registry_expr %>.importmap)
    end

    # Propshaft only serves files you list, so this lists every .css under
    # app/assets/stylesheets/<%= ns %>* (recursively), application.css first:
    #   <%%= <%= helper_prefix %>_stylesheet_tags media: "all" %>
    def <%= helper_prefix %>_stylesheet_tags(**options)
      stylesheet_link_tag(*<%= helper_prefix %>_stylesheet_paths, **options)
    end

    private

    def <%= helper_prefix %>_stylesheet_paths
      root = <%= mod %>::Engine.root.join("app/assets/stylesheets")
      Dir.glob(["<%= ns %>*.css", "<%= ns %>*/**/*.css"], base: root.to_s)
         .map { |path| path.delete_suffix(".css") }
         .sort_by { |path| [path == "<%= ns %>/application" ? 0 : 1, path] }
    end
  end
end
