# frozen_string_literal: true
# Generated by `rails g active_engine:assetable --mode isolated`. Safe to edit.

require "importmap-rails"

module <%= mod %>
  # This engine's own importmap, separate from the host's (Rails.application.importmap).
  # Layouts render it with <%= helper_prefix %>_importmap_tags.
  class Assets
    def initialize
      @watches = []
      @hooked  = false
    end

    def importmap = (@importmap ||= Importmap::Map.new)

    # Pins every .js file under dir as <namespace>/<path>.
    def pin(namespace, dir) = importmap.pin_all_from(dir.to_s, under: namespace)

    # Draws a config/importmap.rb into the map (use absolute paths for local files).
    def watch(dir) = (@watches |= [dir.to_s])
    def draw(file) = importmap.draw(file)

    # Development only: clear the map's cache when watched .js files change.
    def sweep!
      return unless Rails.env.development? && @watches.any?

      importmap.cache_sweeper(watches: @watches.map { |dir| Pathname.new(dir) })
      return if @hooked

      @hooked = true
      registry = self
      ActiveSupport.on_load(:action_controller_base) { before_action { registry.refresh! } }
    end

    def refresh! = importmap.cache_sweeper&.execute_if_updated
  end

  def self.assets = (@assets ||= Assets.new)
end
