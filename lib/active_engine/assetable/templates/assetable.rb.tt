# frozen_string_literal: true
# Generated by `rails g active_engine:assetable`. Safe to edit.

require "active_support/concern"
<% if isolated? -%>
require "<%= engine_path %>/assets"
<% end -%>

module <%= mod %>
  module Concerns
    # Wires this engine's JavaScript and CSS into Propshaft + importmap:
    #
    #   app/javascript/<%= ns %>/          pinned as <%= ns %>/<file>
    #   app/assets/stylesheets/<%= ns %>/  served by Propshaft (list with <%= helper_prefix %>_stylesheet_tags)
    #   config/importmap.rb               extra pins (vendor files; absolute paths for local files)
    #
    # Include AFTER isolate_namespace (initializer names use engine_name).
    module Assetable
      extend ActiveSupport::Concern

      NAMESPACE = "<%= ns %>"

      included do
        initializer "#{engine_name}.assetable" do |app|
          registry = <%= registry_expr %>
          js_root  = root.join("app/javascript")
          css_root = root.join("app/assets/stylesheets")

          if app.config.respond_to?(:assets)
            [js_root, css_root].each do |dir|
              app.config.assets.paths << dir if dir.exist? && !app.config.assets.paths.include?(dir)
            end
          end

          registry.pin(NAMESPACE, js_root.join(NAMESPACE)) if js_root.join(NAMESPACE).exist?
          registry.draw(root.join("config/importmap.rb")) if root.join("config/importmap.rb").exist?
          registry.watch(js_root) if js_root.exist?

          app.config.after_initialize { registry.sweep! } if registry.respond_to?(:sweep!)

          # Explicit helper registration: isolated engines only get `helper :all` in their own
          # controllers, so layouts rendered elsewhere (shared mode) would miss these helpers.
          # to_prepare lets Zeitwerk autoload the module (and re-include it after reloads).
          app.config.to_prepare { ActionController::Base.helper(<%= mod %>::AssetsHelper) }
        end
      end
    end
  end
end
